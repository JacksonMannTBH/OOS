# Out Of Sight local development

# Supabase server credentials. Never expose the service-role key to browsers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public canonical URL used for metadata and share links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional basemap override.
NEXT_PUBLIC_MAP_STYLE_URL=

# OpenSky fallback credentials.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Netlify scheduled/background function authentication.
CRON_SECRET=

# Web Push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional administration access.
ADMIN_PASSCODE=
